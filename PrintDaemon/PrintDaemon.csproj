<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrintDaemon</RootNamespace>
    <AssemblyName>PrintDaemon</AssemblyName>
    
    <!-- Publication en un seul fichier -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Optimisations -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- Infos assembly -->
    <Version>1.1.0</Version>
    <Company>Doudou Tacos</Company>
    <Product>Quick Order Hub - Print Daemon</Product>
    <Description>Service d'impression ESC/POS pour Quick Order Hub</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nécessaire pour PrinterSettings.InstalledPrinters -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
